<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gift_of_the_givers</AssemblyName>
    <RootNamespace>gift_of_the_givers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Database\Schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The Azure Functions project lives in a sub-folder of this solution; keep its files out of the web project. -->
  <ItemGroup>
    <Compile Remove="GiftOfTheGivers.Functions\**" />
    <Content Remove="GiftOfTheGivers.Functions\**" />
    <EmbeddedResource Remove="GiftOfTheGivers.Functions\**" />
    <None Remove="GiftOfTheGivers.Functions\**" />
    <Compile Remove="GiftOfTheGivers.Tests\**" />
    <Content Remove="GiftOfTheGivers.Tests\**" />
    <EmbeddedResource Remove="GiftOfTheGivers.Tests\**" />
    <None Remove="GiftOfTheGivers.Tests\**" />
  </ItemGroup>

</Project>
