@page "{id:int}"
@model GiftOfTheGivers.Pages.DonateThankYouModel
@{
    ViewData["Title"] = "Thank You";
}

<div class="w-full min-h-[70vh] flex items-center justify-center bg-[#eef2e3] px-4 py-16">
    <div class="bg-white rounded-[16px] p-8 md:p-12 max-w-lg w-full text-center border border-[#1b1c1b]/10 shadow-sm">
        <div class="w-14 h-14 bg-[#c8f169] rounded-full flex items-center justify-center mx-auto mb-6 text-2xl">✓</div>

        <h1 class="font-serif text-[32px] text-[#00271b] mb-3">Thank You, @Model.Donation.DonorName!</h1>
        <p class="text-[16px] text-[#404944] mb-1">
            Your @(Model.Donation.Frequency == GiftOfTheGivers.Models.DonationFrequency.OneTime ? "one-time" : "recurring") donation of
            <strong class="text-[#1b1c1b]">@Model.Donation.Currency @Model.Donation.Amount.ToString("N2")</strong> has been recorded.
        </p>
        <p class="text-[13px] text-[#707974] mb-8">Reference: @Model.Donation.CertificateReference</p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a asp-page="/DonateCertificate" asp-route-id="@Model.Donation.Id"
               class="bg-[#043f2e] text-white px-6 py-3 rounded-[4px] text-[14px] font-semibold hover:bg-[#085a43]">
                Download Tax Certificate (PDF)
            </a>
            <a asp-page="/Index" class="border border-[#1b1c1b]/20 px-6 py-3 rounded-[4px] text-[14px] font-semibold hover:bg-[#eef2e3]">
                Return to Home
            </a>
        </div>

        <p class="text-[12px] text-[#a3a89f] mt-8">Prototype note: no real payment is processed. This is a demo record.</p>
    </div>
</div>
