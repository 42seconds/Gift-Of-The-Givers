@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-section page-section--light">
    <div class="content-wrap">
        <div class="section-heading">
            <span class="kicker">Privacy</span>
            <h1 class="section-title">Privacy policy</h1>
            <p class="section-copy">
                This placeholder page explains how the portal handles data such as donations, volunteer sign-ups, and account details.
            </p>
        </div>

        <div class="panel">
            <h2 class="panel__title">What we store</h2>
            <p class="panel__text">
                The portal stores only the information needed for authentication, donations, volunteer records, and employee updates.
                It uses SQL Client directly, so the data stays in the same relational model you see across the app.
            </p>
        </div>
    </div>
</section>
