@page
@model gift_of_the_givers.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="page-section page-section--light auth-page">
    <div class="content-wrap">
        <div class="split-grid">
            <div class="impact-card">
                <span class="kicker">Create account</span>
                <h1 class="impact-card__title">Join the portal</h1>
                <p class="impact-card__copy">
                    Registration keeps first name and last name separate so the account record stays clean while still showing the full display name.
                </p>

                <div class="impact-list">
                    <div class="impact-item">
                        <div class="impact-item__icon">1</div>
                        <div>
                            <p class="impact-item__label">One login</p>
                            <p class="impact-item__copy">Use one account for donations, volunteering, and employee access.</p>
                        </div>
                    </div>
                    <div class="impact-item">
                        <div class="impact-item__icon">2</div>
                        <div>
                            <p class="impact-item__label">Role-based access</p>
                            <p class="impact-item__copy">Employee permissions stay separate from donor accounts.</p>
                        </div>
                    </div>
                    <div class="impact-item">
                        <div class="impact-item__icon">3</div>
                        <div>
                            <p class="impact-item__label">SQL Client storage</p>
                            <p class="impact-item__copy">The app writes users into the same SQL Server data model.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <h2 class="form-card__title">Create your account</h2>
                <p class="muted-text">Fill in the fields below to register as a donor profile.</p>

                <form method="post" class="form-grid auth-form">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-grid form-grid--two">
                        <div class="field">
                            <label asp-for="Input.FirstName">First name</label>
                            <input asp-for="Input.FirstName" class="input" autocomplete="given-name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.LastName">Last name</label>
                            <input asp-for="Input.LastName" class="input" autocomplete="family-name" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Email">Email address</label>
                        <input asp-for="Input.Email" class="input" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-grid form-grid--two">
                        <div class="field">
                            <label asp-for="Input.Password">Password</label>
                            <div class="password-field">
                                <input asp-for="Input.Password" class="input password-field__input" autocomplete="new-password" data-password-input />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                                    <svg class="password-toggle__icon" data-password-icon="show" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M2.5 12S6.5 5.5 12 5.5 21.5 12 21.5 12 17.5 18.5 12 18.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                        <circle cx="12" cy="12" r="2.75" stroke="currentColor" stroke-width="1.8" />
                                    </svg>
                                    <svg class="password-toggle__icon" data-password-icon="hide" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
                                        <path d="M4 4l16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M10.9 10.9A2 2 0 1 0 13.1 13.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M8.7 8.7C5.8 10.2 3.8 12 2.5 12c0 0 4 6.5 9.5 6.5 1.4 0 2.7-.3 3.9-.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M9.4 5.7A10.2 10.2 0 0 1 12 5.5c5.5 0 9.5 6.5 9.5 6.5a19.1 19.1 0 0 1-3.2 3.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.ConfirmPassword">Confirm password</label>
                            <div class="password-field">
                                <input asp-for="Input.ConfirmPassword" class="input password-field__input" autocomplete="new-password" data-password-input />
                                <button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                                    <svg class="password-toggle__icon" data-password-icon="show" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M2.5 12S6.5 5.5 12 5.5 21.5 12 21.5 12 17.5 18.5 12 18.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                        <circle cx="12" cy="12" r="2.75" stroke="currentColor" stroke-width="1.8" />
                                    </svg>
                                    <svg class="password-toggle__icon" data-password-icon="hide" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
                                        <path d="M4 4l16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M10.9 10.9A2 2 0 1 0 13.1 13.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M8.7 8.7C5.8 10.2 3.8 12 2.5 12c0 0 4 6.5 9.5 6.5 1.4 0 2.7-.3 3.9-.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                        <path d="M9.4 5.7A10.2 10.2 0 0 1 12 5.5c5.5 0 9.5 6.5 9.5 6.5a19.1 19.1 0 0 1-3.2 3.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="button-row auth-actions">
                        <a class="ui-button ui-button--secondary" asp-page="/Account/Login">Already have an account?</a>
                        <button type="submit" class="ui-button ui-button--primary">Register</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
