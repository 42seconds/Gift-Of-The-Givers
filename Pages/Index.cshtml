@page
@model gift_of_the_givers.Pages.IndexModel
@{
    ViewData["Title"] = "Home";

    var reliefPacking = "https://lh3.googleusercontent.com/aida-public/AB6AXuCWoLV2PCbTDztOpcQZN6kXwSMXCKvsDGkVzMARzhc0u_wPIgNc9_U3q4kLz8_drOlD6adeptzv31eEOFmF3wXmQ7p762-sJ7EK084uNVx8irFtmD5P4aGA3DqTwRk0t0jF56O4FOzSDgo23Zo-SinzLgKdkLIoqh9Y8cbMyW_rNythRjeCqfu8cMtsBngVaASIX9PkoHYFnHt8vWFPeeQsVaidICBqMsUKqG_cZLbKlcGQSg-bgK8VFg";
}

<section class="page-section page-section--dark">
    <div class="content-wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <div class="hero-card">
                    <div class="hero-card__inner">
                        <span class="kicker">Humanitarian relief</span>
                        <h1 class="hero-card__title">Delivering Relief Faster, Where It Matters Most.</h1>
                        <p class="hero-card__text">
                            This portal keeps the Gift of the Givers visual identity while bringing in login, split-name
                            registration, donations, volunteer sign-up, and employee operations as separate Razor Pages.
                        </p>

                        <div class="button-row">
                            <a class="ui-button ui-button--secondary" asp-page="/Donation/Index">Donate Now</a>
                            <a class="ui-button ui-button--secondary" asp-page="/Volunteer/Register">Become a Volunteer</a>
                            <a class="ui-button ui-button--primary" asp-page="/Account/Login">Login</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hero-media">
                <img src="@reliefPacking" alt="Volunteers packing humanitarian relief supplies in a logistics hub" />

                <div class="hero-stat">
                    <div class="hero-stat__top">
                        <div>
                            <p class="hero-stat__label">Impact this month</p>
                            <p class="hero-stat__value">3,200+</p>
                        </div>
                        <div class="section-icon" style="background:rgba(200,241,105,0.2);color:var(--accent);">
                            Impact
                        </div>
                    </div>
                    <p class="hero-stat__text">
                        Households reached with immediate food, water, medical, and shelter support.
                    </p>
                    <div class="sparkline" aria-hidden="true">
                        <span style="height:25%"></span>
                        <span style="height:45%"></span>
                        <span style="height:35%"></span>
                        <span style="height:65%"></span>
                        <span style="height:85%"></span>
                        <span style="height:100%"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="page-section page-section--light">
    <div class="content-wrap">
        <div class="section-heading">
            <span class="kicker">Operations and community</span>
            <h2 class="section-title">Clear the path from need to relief, together</h2>
            <p class="section-copy">
                The same clean green-and-gold editorial style now frames the authentication, donation, volunteer,
                and employee screens so the whole portal feels like one design system.
            </p>
        </div>

        <div class="two-up">
            <div class="panel panel--soft">
                <span class="kicker">Operations</span>
                <h3 class="panel__title" style="margin-top:0.85rem;">Built for response teams</h3>
                <p class="panel__text">
                    Track donor records, volunteer sign-ups, and project updates in a simple SQL-backed workspace that
                    stays readable on every screen size.
                </p>

                <ul class="meta-list">
                    <li><span class="check-mark">✓</span> Cookie-based authentication</li>
                    <li><span class="check-mark">✓</span> Separate Razor Pages for each flow</li>
                    <li><span class="check-mark">✓</span> Simple SQL Client data access</li>
                </ul>
            </div>

            <div class="panel panel--accent">
                <span class="kicker" style="background:rgba(0,0,0,0.08);color:#151f00;">Community</span>
                <h3 class="panel__title" style="margin-top:0.85rem;">And the communities you serve</h3>
                <p class="panel__text" style="color:rgba(21,31,0,0.82);">
                    Donations, volunteer registrations, and employee updates all sit inside the same calm, editorial
                    layout instead of feeling like separate apps.
                </p>

                <div class="mini-preview-row" style="margin-top:1rem;">
                    <div class="mini-card">
                        <div class="mini-card__head">
                            <span class="mini-card__title">Active Volunteers</span>
                            <span class="mini-card__stat">342 Live</span>
                        </div>
                        <div class="mini-lines">
                            <div class="mini-line">
                                <span class="avatar-dot" style="background:var(--forest);">J</span>
                                <span class="line-bar line-bar--olive"></span>
                                <span class="line-bar line-bar--tiny"></span>
                            </div>
                            <div class="mini-line">
                                <span class="avatar-dot" style="background:var(--olive-2);">T</span>
                                <span class="line-bar line-bar--accent"></span>
                                <span class="line-bar line-bar--short"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mini-card">
                        <div class="mini-card__head">
                            <span class="mini-card__title">Funding Goal</span>
                            <span class="mini-card__stat">65% Reached</span>
                        </div>
                        <div class="mini-progress">
                            <div class="mini-progress__fill"></div>
                        </div>
                        <p class="muted-text" style="margin-top:0.8rem;">
                            Donation records are ready for reporting and future certificate generation.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="page-section page-section--dark">
    <div class="content-wrap">
        <div class="section-heading">
            <span class="kicker">Trusted partnerships</span>
            <h2 class="section-title" style="color:#fff;">Built for partners, volunteers, and the teams on the ground</h2>
            <p class="section-copy">
                The portal carries the same composed, high-contrast relief language through every page.
            </p>
        </div>

        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1.1rem 1.6rem;align-items:center;opacity:0.86;margin-bottom:2.5rem;">
            <span class="font-serif" style="font-size:1.3rem;display:inline-flex;align-items:center;gap:0.55rem;">
                <span class="section-icon" style="background:rgba(200,241,105,0.15);color:var(--accent);width:2.2rem;height:2.2rem;">G</span>
                Global Aid
            </span>
            <span class="font-serif" style="font-size:1.3rem;display:inline-flex;align-items:center;gap:0.55rem;">
                <span class="section-icon" style="background:rgba(200,241,105,0.15);color:var(--accent);width:2.2rem;height:2.2rem;">W</span>
                Water Relief
            </span>
            <span class="font-serif" style="font-size:1.3rem;display:inline-flex;align-items:center;gap:0.55rem;">
                <span class="section-icon" style="background:rgba(200,241,105,0.15);color:var(--accent);width:2.2rem;height:2.2rem;">M</span>
                Medical Teams
            </span>
            <span class="font-serif" style="font-size:1.3rem;display:inline-flex;align-items:center;gap:0.55rem;">
                <span class="section-icon" style="background:rgba(200,241,105,0.15);color:var(--accent);width:2.2rem;height:2.2rem;">R</span>
                Rescue Network
            </span>
        </div>

        <div class="testimonial">
            <div class="testimonial__quote">“</div>
            <div class="testimonial__text">
                The immediate response and structured support made the whole relief process feel calm, clear, and
                dignified.
            </div>
            <div class="testimonial__person">
                <span class="persona-badge">SL</span>
                <strong>Support Liaison</strong>
                <span style="font-size:0.85rem;opacity:0.8;">Community coordination and relief operations</span>
            </div>
        </div>
    </div>
</section>

<section class="page-section page-section--light">
    <div class="content-wrap">
        <div class="two-up">
            <div class="panel">
                <span class="kicker">Get involved</span>
                <h2 class="panel__title" style="margin-top:0.85rem;">Join a volunteer orientation</h2>
                <p class="panel__text">
                    Learn how the portal supports volunteer sign-ups, donor records, and field updates in one clean
                    workspace.
                </p>

                <div class="schedule-list">
                    <div class="schedule-card">
                        <div>
                            <p class="schedule-card__title">Saturday, Sept 5, 2026</p>
                            <p class="schedule-card__meta">10:00 AM - 1:00 PM SAST</p>
                            <p class="schedule-card__location">Johannesburg Logistics Hub & Online Stream</p>
                        </div>
                        <a class="ui-button ui-button--primary" asp-page="/Volunteer/Register">RSVP</a>
                    </div>
                    <div class="schedule-card">
                        <div>
                            <p class="schedule-card__title">Wednesday, Sept 9, 2026</p>
                            <p class="schedule-card__meta">6:00 PM - 8:30 PM SAST</p>
                            <p class="schedule-card__location">Cape Town Regional Center</p>
                        </div>
                        <a class="ui-button ui-button--primary" asp-page="/Volunteer/Register">RSVP</a>
                    </div>
                    <div class="schedule-card">
                        <div>
                            <p class="schedule-card__title">Saturday, Sept 12, 2026</p>
                            <p class="schedule-card__meta">09:30 AM - 12:30 PM SAST</p>
                            <p class="schedule-card__location">Durban Disaster Depot & Virtual Room</p>
                        </div>
                        <a class="ui-button ui-button--primary" asp-page="/Volunteer/Register">RSVP</a>
                    </div>
                </div>

                <div class="button-row">
                    <a class="ui-button ui-button--secondary" asp-page="/Contact">Contact us</a>
                    <a class="ui-button ui-button--secondary" asp-page="/OurWork">See our work</a>
                </div>
            </div>

            <div class="bento-grid">
                <div class="bento-tile bento-tile--large">
                    <span class="feature-badge">Donate</span>
                    <h3 class="initiative-card__title" style="margin-top:0.9rem;">Donation portal</h3>
                    <p class="initiative-card__copy">
                        A clean donation form with anonymous support, recurring giving, and simple SQL-backed storage.
                    </p>
                </div>

                <div class="bento-tile">
                    <span class="feature-badge">Volunteer</span>
                    <h3 class="bento-tile__title" style="margin-top:0.8rem;">Volunteer intake</h3>
                    <p class="muted-text">Availability, skills, and contact details on one page.</p>
                </div>

                <div class="bento-tile">
                    <span class="feature-badge">Employee</span>
                    <h3 class="bento-tile__title" style="margin-top:0.8rem;">Operations dashboard</h3>
                    <p class="muted-text">Post updates and review recent donation and volunteer records.</p>
                </div>

                <div class="bento-tile">
                    <span class="feature-badge">Auth</span>
                    <h3 class="bento-tile__title" style="margin-top:0.8rem;">Secure sign-in</h3>
                    <p class="muted-text">Login and registration stay separate, simple, and readable.</p>
                </div>

                <div class="bento-tile">
                    <span class="feature-badge">Support</span>
                    <h3 class="bento-tile__title" style="margin-top:0.8rem;">24/7 hotline</h3>
                    <p class="muted-text">A calm contact point for disaster response and coordination.</p>
                </div>
            </div>
        </div>
    </div>
</section>
