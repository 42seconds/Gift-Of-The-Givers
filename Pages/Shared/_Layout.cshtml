<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gift of the Givers</title>

    <!-- Fonts: Lora (serif headings) + Inter (sans body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!--
      Tailwind via Play CDN — fast path for a coursework prototype.
      For a production build this should be replaced with the Tailwind CLI
      compiled into wwwroot/css/site.css, but this keeps every [#hex]
      utility class from the design ported as-is without a build step.
    -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
        h1, h2, h3, h4, h5, h6, .font-serif { font-family: 'Lora', Georgia, serif; }
        .font-sans { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-[#eef2e3] antialiased selection:bg-[#c8f169] selection:text-[#151f00]">

    <partial name="_Nav" />

    <!-- Toast notification (server round-trip driven via TempData) -->
    @if (TempData["Notification"] is string notice)
    {
        <div id="toast" class="fixed bottom-6 right-6 z-50 bg-[#043f2e] text-white px-5 py-3.5 rounded-[8px] shadow-2xl border border-[#c8f169]/30 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c8f169" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span class="font-sans text-[14px] font-medium">@notice</span>
            <button onclick="document.getElementById('toast').remove()" class="text-white/70 hover:text-white ml-2 p-1">✕</button>
        </div>
        <script>
            setTimeout(() => { const t = document.getElementById('toast'); if (t) t.remove(); }, 4500);
        </script>
    }

    <div class="flex-1 pt-20">
        @RenderBody()
    </div>

    <partial name="_Footer" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
