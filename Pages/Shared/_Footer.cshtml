@{
    // NOTE: Hotline number and PBO/NPO registration numbers below were carried
    // over from the AI-generated design as placeholders. Verify these against
    // Gift of the Givers' actual public information before treating as final —
    // do not ship fabricated registration numbers as fact.
}
<footer class="bg-[#032a1f] text-white border-t border-[#0d5c3f]/40 relative z-10"
        style="background-image: radial-gradient(circle at 30% 0%, #0d5c3f 0%, #032a1f 55%);">
    <div class="mx-auto w-full max-w-[1240px] px-4 md:px-8 pt-16 pb-8">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10 lg:gap-12 pb-14 border-b border-[#13533c]/60">

            <!-- Brand & Mission -->
            <div class="lg:col-span-2 flex flex-col justify-between">
                <div>
                    <a asp-page="/Index" class="text-left inline-block">
                        <partial name="_Logo" model="(Size: 48, LightText: true)" />
                    </a>

                    <p class="mt-4 text-[14px] leading-relaxed text-[#a3c9b7] max-w-sm">
                        The largest disaster response non-governmental organization of African origin on the African continent. Unconditional humanitarian assistance across 45+ nations since 1992.
                    </p>

                    <!-- PLACEHOLDER — verify against real GOTG hotline before final submission -->
                    <div class="mt-5 p-3.5 rounded-[8px] bg-[#043f2e]/80 border border-[#c8f169]/20 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-[#c8f169]/15 flex items-center justify-center shrink-0 text-[#c8f169]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase tracking-wider text-[#c8f169] font-medium">24/7 Disaster Toll-Free Hotline</div>
                            <a href="tel:0800786911" class="text-[14px] font-bold text-white hover:text-[#c8f169]">0800 786 911 / +27 33 345 0163</a>
                        </div>
                    </div>
                </div>

                <div class="mt-6">
                    <span class="text-[12px] uppercase tracking-wider text-[#c8f169] block mb-2 font-semibold">Subscribe to Field Situation Reports</span>
                    <form id="newsletterForm" class="flex gap-2 max-w-sm">
                        <input type="email" name="email" placeholder="name@example.com" required
                               class="h-10 w-full rounded-[6px] border border-[#1b6b4e] bg-[#021f17]/70 px-3.5 text-sm text-white placeholder:text-[#5a8d79] focus:border-[#c8f169] focus:outline-none" />
                        <button type="submit" id="newsletterBtn"
                                class="h-10 shrink-0 rounded-[6px] bg-[#c8f169] px-4 text-xs uppercase tracking-wider font-bold text-[#151f00] hover:bg-[#b7e354] flex items-center gap-1.5">
                            Join
                        </button>
                    </form>
                </div>
            </div>

            <!-- Nav Columns -->
            <nav class="grid grid-cols-2 sm:grid-cols-3 lg:col-span-4 gap-8">
                <div>
                    <h3 class="text-xs uppercase tracking-widest text-[#c8f169] font-semibold mb-4">Explore Relief</h3>
                    <ul class="flex flex-col space-y-3 text-sm">
                        <li><a asp-page="/About" class="text-[#a3c9b7] hover:text-[#c8f169]">About Us &amp; History</a></li>
                        <li><a asp-page="/OurWork" class="text-[#a3c9b7] hover:text-[#c8f169]">Active Disaster Projects</a></li>
                        <li><a asp-page="/OurWork" class="text-[#a3c9b7] hover:text-[#c8f169]">Search &amp; Rescue Teams</a></li>
                        <li><a asp-page="/OurWork" class="text-[#a3c9b7] hover:text-[#c8f169]">Medical Interventions</a></li>
                        <li><a asp-page="/Employee/Dashboard" class="text-[#a3c9b7] hover:text-[#c8f169] font-medium">Employee Operations Portal →</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xs uppercase tracking-widest text-[#c8f169] font-semibold mb-4">Get Involved</h3>
                    <ul class="flex flex-col space-y-3 text-sm">
                        <li><a asp-page="/Donate" class="text-[#a3c9b7] hover:text-[#c8f169] font-medium">Make a Donation</a></li>
                        <li><a asp-page="/Volunteer" class="text-[#a3c9b7] hover:text-[#c8f169]">Volunteer Roster</a></li>
                        <li><a asp-page="/Contact" class="text-[#a3c9b7] hover:text-[#c8f169]">Corporate CSI Partnerships</a></li>
                        <li><a asp-page="/Volunteer" class="text-[#a3c9b7] hover:text-[#c8f169]">Orientation Schedules</a></li>
                        <li><a asp-page="/Donate" class="text-[#a3c9b7] hover:text-[#c8f169]">Monthly Giving Circle</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xs uppercase tracking-widest text-[#c8f169] font-semibold mb-4">Governance &amp; Tax</h3>
                    <!-- PLACEHOLDER — verify PBO/NPO numbers against real GOTG records -->
                    <ul class="flex flex-col space-y-3 text-sm text-[#a3c9b7]">
                        <li class="text-white/90">PBO: [verify number]</li>
                        <li>Registered NPO: [verify number]</li>
                        <li>Section 18A Tax Certificates</li>
                        <li><a asp-page="/About" class="hover:text-[#c8f169]">Audited Annual Reports</a></li>
                        <li><a asp-page="/Contact" class="hover:text-[#c8f169]">Headquarters Pietermaritzburg</a></li>
                    </ul>
                </div>
            </nav>
        </div>

        <div class="mt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#a3c9b7]/80">
            <div class="flex items-center gap-2">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#c8f169] opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#c8f169]"></span>
                </span>
                <span class="text-white font-medium">Disaster Command Center: Operations Live</span>
            </div>
            <div class="text-center md:text-left">© @DateTime.Now.Year Gift of the Givers Foundation. All rights reserved.</div>
            <div class="flex items-center gap-3">
                <button id="shareBtn" class="flex items-center gap-1.5 bg-[#043f2e] hover:bg-[#085a43] text-white px-3 py-1.5 rounded-[4px] border border-[#1b6b4e]">
                    <span id="shareLabel">Share</span>
                </button>
                <span class="hidden sm:inline text-[#5a8d79]">|</span>
                <span class="hidden sm:inline text-white/90">South Africa · Global Missions</span>
            </div>
        </div>
    </div>
</footer>

<script>
    (function () {
        var form = document.getElementById('newsletterForm');
        var btn = document.getElementById('newsletterBtn');
        if (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                btn.textContent = 'Subscribed';
                setTimeout(function () { btn.textContent = 'Join'; form.reset(); }, 4000);
            });
        }
        var shareBtn = document.getElementById('shareBtn');
        var shareLabel = document.getElementById('shareLabel');
        if (shareBtn) {
            shareBtn.addEventListener('click', function () {
                if (navigator.share) {
                    navigator.share({ title: 'Gift of the Givers - Disaster Relief', url: window.location.href }).catch(function () {});
                } else {
                    navigator.clipboard.writeText(window.location.href);
                    shareLabel.textContent = 'Copied Link!';
                    setTimeout(function () { shareLabel.textContent = 'Share'; }, 2500);
                }
            });
        }
    })();
</script>
