@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-section page-section--light">
    <div class="content-wrap">
        <div class="split-grid">
            <div class="impact-card">
                <span class="kicker">Error</span>
                <h1 class="impact-card__title">Something went wrong</h1>
                <p class="impact-card__copy">
                    The request could not be completed. Please try again, or return home and continue from there.
                </p>
            </div>

            <div class="form-card">
                <h2 class="form-card__title">Diagnostics</h2>
                <p class="muted-text">
                    The detailed stack trace is shown only in development so production stays calm and simple.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="receipt-box">
                        <div class="receipt-row">
                            <span>Request ID</span>
                            <span class="receipt-value"><code>@Model.RequestId</code></span>
                        </div>
                    </div>
                }

                <div class="button-row">
                    <a class="ui-button ui-button--secondary" asp-page="/Index">Back home</a>
                    <a class="ui-button ui-button--primary" asp-page="/Contact">Contact support</a>
                </div>
            </div>
        </div>
    </div>
</section>
