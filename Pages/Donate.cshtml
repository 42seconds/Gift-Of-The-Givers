@page
@model GiftOfTheGivers.Pages.DonateModel
@{
    ViewData["Title"] = "Donate";
}

<div class="w-full min-h-screen bg-[#eef2e3] pt-6 md:pt-10 pb-20 px-4 md:px-10">
    <main class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">

            <!-- Left: Reassurance & Impact -->
            <div class="space-y-8">
                <div class="space-y-4">
                    <h1 class="font-serif text-[36px] sm:text-[44px] md:text-[48px] text-[#1b1c1b] leading-tight font-normal">Empower Humanity.</h1>
                    <p class="text-[16px] md:text-[18px] text-[#404944] max-w-md leading-relaxed">
                        Your contribution directly funds life-saving interventions, disaster relief, and sustainable development projects. We ensure absolute transparency and rapid deployment where it's needed most.
                    </p>
                </div>

                <div class="bg-[#043f2e] text-white rounded-[16px] p-8 space-y-6 border border-white/10 shadow-lg">
                    <h3 class="font-serif text-[28px] md:text-[34px] text-[#c8f169] leading-snug">The Impact of Giving</h3>
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="p-2.5 bg-white/10 rounded-full text-[#c8f169] shrink-0">💧</div>
                            <div>
                                <div class="text-[15px] font-bold text-[#c8f169]">R500 / $30</div>
                                <div class="text-[15px] text-[#76ab94] mt-1 leading-relaxed">Provides clean drinking water for a family of four for a month.</div>
                            </div>
                        </div>
                        <div class="w-full h-px bg-white/10"></div>
                        <div class="flex items-start gap-4">
                            <div class="p-2.5 bg-white/10 rounded-full text-[#c8f169] shrink-0">✚</div>
                            <div>
                                <div class="text-[15px] font-bold text-[#c8f169]">R1000 / $60</div>
                                <div class="text-[15px] text-[#76ab94] mt-1 leading-relaxed">Funds emergency medical supplies for a rural clinic.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="h-64 sm:h-72 rounded-[16px] overflow-hidden shadow-md border border-[#1b1c1b]/10">
                    <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1000&auto=format&fit=crop" alt="Hands planting a sapling in soil" />
                </div>
            </div>

            <!-- Right: Form or Success -->
            <div class="bg-white rounded-[16px] p-6 sm:p-8 md:p-10 border border-[#1b1c1b]/10 shadow-sm relative z-10">

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <p class="text-sm text-[#404944] mb-4">Donating as <strong>@User.Identity.Name</strong>.</p>
                }
                else
                {
                    <p class="text-sm text-[#404944] mb-4">
                        Donating as a guest —
                        <a asp-area="Identity" asp-page="/Account/Login" class="text-[#356854] font-semibold hover:underline">log in</a>
                        to track your donation history.
                    </p>
                }

                <form method="post" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <label class="flex items-center gap-2.5 cursor-pointer">
                            <input type="checkbox" asp-for="DonateAsGuest" class="rounded border-[#707974]" />
                            <span class="text-[13px] text-[#404944]">Donate anonymously instead of using my account</span>
                        </label>
                    }

                    <!-- Currency toggle -->
                    <div class="flex justify-between items-center">
                        <span class="text-[12px] uppercase tracking-[0.06em] font-semibold text-[#404944]">Select Currency</span>
                        <div class="flex gap-2">
                            @foreach (var c in new[] { "ZAR", "USD", "EUR" })
                            {
                                <label class="cursor-pointer">
                                    <input type="radio" name="Donation.Currency" value="@c" class="peer sr-only" checked="@(Model.Donation.Currency.ToString() == c)" />
                                    <span class="text-[12px] font-medium px-3 py-1 rounded-[4px] bg-[#f0edeb] text-[#404944] peer-checked:bg-[#043f2e] peer-checked:text-[#c8f169] inline-block">@c</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Amount presets -->
                    <div class="grid grid-cols-3 gap-3 sm:gap-4" id="presetGroup">
                        @foreach (var amt in new[] { 250, 500, 1000 })
                        {
                            <button type="button" data-amount="@amt" class="preset-btn py-4 rounded-[4px] text-[16px] font-semibold border border-[#c0c9c2] hover:border-[#c8f169] hover:bg-[#c8f169]/5 text-[#1b1c1b] transition-all">
                                R@amt
                            </button>
                        }
                    </div>

                    <div>
                        <label class="block text-[12px] uppercase tracking-[0.06em] font-semibold text-[#404944] mb-2">Amount</label>
                        <input asp-for="Donation.Amount" id="amountInput" type="number" step="0.01" min="10" placeholder="e.g. 250"
                               class="w-full px-4 py-3 rounded-[4px] border border-[#c0c9c2] focus:ring-1 focus:ring-[#c8f169] focus:border-[#c8f169] outline-none" />
                        <span asp-validation-for="Donation.Amount" class="text-red-600 text-xs"></span>
                    </div>

                    <div>
                        <label class="block text-[12px] uppercase tracking-[0.06em] font-semibold text-[#404944] mb-2">Donation Type</label>
                        <div class="flex gap-4">
                            <label class="flex items-center gap-2"><input type="radio" name="Donation.Frequency" value="OneTime" checked /> <span class="text-sm">One-Time</span></label>
                            <label class="flex items-center gap-2"><input type="radio" name="Donation.Frequency" value="Recurring" /> <span class="text-sm">Recurring (Monthly)</span></label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[12px] uppercase tracking-[0.06em] font-semibold text-[#404944] mb-2">Designate My Gift To</label>
                        <select class="w-full px-4 py-3 rounded-[4px] border border-[#c0c9c2] focus:ring-1 focus:ring-[#c8f169] focus:border-[#c8f169] outline-none">
                            <option>General Relief Fund (Where most urgent)</option>
                            <option>KwaZulu-Natal Flood Relief</option>
                            <option>Clean Water Boreholes</option>
                        </select>
                    </div>

                    <div class="w-full h-px bg-[#1b1c1b]/10"></div>

                    @if (User.Identity == null || !User.Identity.IsAuthenticated)
                    {
                        <div class="space-y-4">
                            <h4 class="font-serif text-[22px] text-[#1b1c1b]">Your Details</h4>
                            <div>
                                <label class="block text-[12px] uppercase tracking-[0.06em] font-semibold text-[#404944] mb-2">Full Name</label>
                                <input asp-for="Donation.DonorName" placeholder="e.g. Jane Dlamini"
                                       class="w-full px-4 py-3 rounded-[4px] border border-[#c0c9c2] focus:ring-1 focus:ring-[#c8f169] focus:border-[#c8f169] outline-none" />
                            </div>
                            <div>
                                <label class="block text-[12px] uppercase tracking-[0.06em] font-semibold text-[#404944] mb-2">Email Address</label>
                                <input asp-for="Donation.DonorEmail" type="email" placeholder="you@example.com"
                                       class="w-full px-4 py-3 rounded-[4px] border border-[#c0c9c2] focus:ring-1 focus:ring-[#c8f169] focus:border-[#c8f169] outline-none" />
                            </div>
                        </div>
                    }

                    <button type="submit" class="w-full bg-[#c8f169] text-[#151f00] py-4 rounded-[4px] text-[15px] font-bold hover:bg-[#add450] active:scale-[0.99] transition-all flex justify-center items-center gap-2">
                        Donate Now ♥
                    </button>

                    <div class="flex items-center justify-center gap-1.5 text-center text-[11px] uppercase tracking-[0.06em] text-[#707974]">
                        <span>🛡️ This is a prototype — no real payment is processed</span>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (function () {
            var amountInput = document.getElementById('amountInput');
            document.querySelectorAll('.preset-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    amountInput.value = btn.dataset.amount;
                    document.querySelectorAll('.preset-btn').forEach(function (b) {
                        b.classList.remove('border-2', 'border-[#c8f169]', 'bg-[#c8f169]/15', 'ring-1', 'ring-[#c8f169]');
                    });
                    btn.classList.add('border-2', 'border-[#c8f169]', 'bg-[#c8f169]/15', 'ring-1', 'ring-[#c8f169]');
                });
            });
        })();
    </script>
}
