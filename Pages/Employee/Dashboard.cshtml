@page
@model gift_of_the_givers.Pages.Employee.DashboardModel
@{
    ViewData["Title"] = "Employee Dashboard";
}

<section class="page-section page-section--light">
    <div class="content-wrap dashboard-shell">
        <div class="impact-card">
            <span class="kicker">Employee access</span>
            <h1 class="impact-card__title">Employee dashboard</h1>
            <p class="impact-card__copy">
                Review the latest donations and volunteer sign-ups, then post short project updates from the same SQL-backed workspace.
            </p>
        </div>

        <div class="dashboard-summary-grid">
            <article class="dashboard-card">
                <span class="feature-badge">Donations</span>
                <div class="summary-number">@Model.DonationCount</div>
                <p class="muted-text">Recent donation entries loaded from the database.</p>
            </article>
            <article class="dashboard-card">
                <span class="feature-badge">Total</span>
                <div class="summary-number">@Model.DonationTotal.ToString("N2")</div>
                <p class="muted-text">Combined value of the loaded donation records.</p>
            </article>
            <article class="dashboard-card">
                <span class="feature-badge">Volunteers</span>
                <div class="summary-number">@Model.VolunteerCount</div>
                <p class="muted-text">Recent volunteer submissions ready for follow-up.</p>
            </article>
            <article class="dashboard-card">
                <span class="feature-badge">Updates</span>
                <div class="summary-number">@Model.UpdateCount</div>
                <p class="muted-text">Project updates posted by employees.</p>
            </article>
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-card">
                <h2 class="dashboard-card__title">Post a project update</h2>
                <p class="muted-text">Write a short note that the team can see on the employee dashboard.</p>

                <form method="post" class="form-grid auth-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="field">
                        <label asp-for="ProjectUpdate.Title">Title</label>
                        <input asp-for="ProjectUpdate.Title" class="input" />
                        <span asp-validation-for="ProjectUpdate.Title" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="ProjectUpdate.Description">Description</label>
                        <textarea asp-for="ProjectUpdate.Description" class="textarea" rows="6"></textarea>
                        <span asp-validation-for="ProjectUpdate.Description" class="text-danger"></span>
                    </div>

                    <button type="submit" class="ui-button ui-button--primary">Post update</button>
                </form>
            </div>

            <div class="dashboard-card">
                <h2 class="dashboard-card__title">Latest project updates</h2>
                @if (Model.ProjectUpdates.Count == 0)
                {
                    <p class="muted-text">No updates posted yet.</p>
                }
                else
                {
                    <div class="update-grid">
                        @foreach (var update in Model.ProjectUpdates)
                        {
                            <article class="update-card">
                                <span class="status-badge status-badge--field">Update</span>
                                <h3 class="update-card__title">@update.Title</h3>
                                <p class="update-card__copy">@update.Description</p>
                                <p class="update-card__meta">
                                    Posted by @(update.PostedByName ?? "Employee") on @update.PostedOn.ToString("dd MMM yyyy")
                                </p>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <h2 class="dashboard-card__title">Azure Storage update log</h2>
            <p class="muted-text">Entries written to the ProjectUpdateLog table by the LogProjectUpdate Azure Function.</p>
            @if (Model.StorageLog is null)
            {
                <p class="muted-text">The Azure Function App is not reachable right now.</p>
            }
            else if (Model.StorageLog.Count == 0)
            {
                <p class="muted-text">No updates logged to Azure Storage yet.</p>
            }
            else
            {
                <div class="table-card">
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Update #</th>
                                    <th>Title</th>
                                    <th>Posted by</th>
                                    <th>Logged (UTC)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.StorageLog)
                                {
                                    <tr>
                                        <td>@entry.ProjectUpdateId</td>
                                        <td>@entry.Title</td>
                                        <td>@entry.PostedByName</td>
                                        <td>@entry.LoggedOnUtc.ToString("dd MMM yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-card">
                <h2 class="dashboard-card__title">Recent donations</h2>
                @if (Model.RecentDonations.Count == 0)
                {
                    <p class="muted-text">No donations recorded yet.</p>
                }
                else
                {
                    <div class="table-card">
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Donor</th>
                                        <th>Amount</th>
                                        <th>Frequency</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var donation in Model.RecentDonations)
                                    {
                                        <tr>
                                            <td>@(donation.IsAnonymous ? "Anonymous" : donation.DonorName)</td>
                                            <td>@donation.Currency @donation.Amount.ToString("N2")</td>
                                            <td>@donation.Frequency</td>
                                            <td>@donation.DonationDate.ToString("dd MMM yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <div class="dashboard-card">
                <h2 class="dashboard-card__title">Recent volunteer sign-ups</h2>
                @if (Model.RecentVolunteers.Count == 0)
                {
                    <p class="muted-text">No volunteer sign-ups yet.</p>
                }
                else
                {
                    <div class="volunteer-grid">
                        @foreach (var volunteer in Model.RecentVolunteers)
                        {
                            var volunteerInitial = string.IsNullOrWhiteSpace(volunteer.FullName)
                                ? "?"
                                : volunteer.FullName.Trim()[0].ToString().ToUpperInvariant();

                            <article class="roster-card">
                                <span class="roster-card__icon">@volunteerInitial</span>
                                <h3 class="roster-card__title">@volunteer.FullName</h3>
                                <p class="roster-card__copy">@volunteer.Email</p>
                                <p class="roster-card__meta">Availability: @volunteer.Availability</p>
                                <p class="roster-card__copy" style="margin-top:0.5rem;">Skills: @volunteer.Skills</p>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
